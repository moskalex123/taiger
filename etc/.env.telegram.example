# Telegram Bot Configuration Example
# Copy this to .env and fill in your actual values

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Webhook URL for production deployment
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/api/telegram/webhook

# Secret token for webhook security (optional but recommended)
TELEGRAM_BOT_SECRET=your_webhook_secret_here

# Telegram Mini App URL
TELEGRAM_WEBAPP_URL=https://yourdomain.com

# Default starting balance for new users created via TMA
DEFAULT_STARTING_BALANCE=1.0

# Telegram API Credentials (required for workers)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Note: Other environment variables should be in the main .env file:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost/dbname
# JWT_SECRET_KEY=your_jwt_secret
# AWS_ACCESS_KEY_ID=your_s3_access_key
# AWS_SECRET_ACCESS_KEY=your_s3_secret_key
# AWS_REGION=your_s3_region
# S3_BUCKET_NAME=your_bucket_name
# S3_ENDPOINT_URL=your_s3_endpoint (optional, for MinIO/custom S3)