# Telegram API Configuration
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Session Configuration
SESSION_NAME=micro_client
TEST_USER_ID=7

# Bot Configuration
BOT_USERNAME=@taiger_pro_bot

# S3 Configuration (Optional - for Yandex Cloud session loading)
# Leave empty or unset to use local session files
YC_ACCESS_KEY_ID=your_yandex_cloud_access_key
YC_SECRET_ACCESS_KEY=your_yandex_cloud_secret_key
BUCKET_NAME=your_bucket_name
YC_REGION=ru-central1
YC_ENDPOINT_URL=https://storage.yandexcloud.net