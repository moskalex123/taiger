# Environment Configuration for Taiger Frontend
# Copy this file to .env to configure the application

# UI Design Toggle
# Set to 'true' to enable the new redesigned UI
# Set to 'false' to use the original UI (default)
VITE_ENABLE_REDESIGN=false

# App version for header tag
VITE_APP_VERSION=5

# Other environment variables can be added here as needed
# VITE_API_BASE_URL=http://localhost:8000
# VITE_ENABLE_DEBUG=false
