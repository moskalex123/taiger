        // Don't throw error - worker start failure shouldn't prevent rule creation
      }
    };

    const saveRule = async () => {
      if (savingRule.value) return; // Prevent double submission
      
      // Validate channels and model before saving
      const sourceChannelValue = normalizeChannelForDB(newRule.value.source_channel, subscribedChannels.value);
      const targetChannelValue = normalizeChannelForDB(newRule.value.target_channel, adminChannels.value);
      
      // Check if source channel exists
      if (!sourceChannelValue) {
        showError($t('source_channel_required'));
        savingRule.value = false;
        return;
      }
      
      // Check if target channel exists
      if (!targetChannelValue) {
        showError($t('target_channel_required'));
        savingRule.value = false;
        return;
      }
      
      // Check if source channel is still available
      const sourceChannelExists = subscribedChannels.value.some(c => 
        getChannelValue(c) === sourceChannelValue);
      if (!sourceChannelExists) {
        showError($t('source_channel_no_longer_available'));
        savingRule.value = false;
        return;
      }
      
      // Check if target channel is still available
      const targetChannelExists = adminChannels.value.some(c => 
        getChannelValue(c) === targetChannelValue);
      if (!targetChannelExists) {
        showError($t('target_channel_no_longer_available'));
        savingRule.value = false;
        return;
      }
      
      // Check if model exists (if specified)
      if (newRule.value.model_id) {
        const modelExists = models.value.some(m => m.id === newRule.value.model_id);
        if (!modelExists) {
          showError($t('selected_model_no_longer_available'));
          savingRule.value = false;
          return;
        }
      }
      
      savingRule.value = true;
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        // MODIFIED: Define base path for channel_pairs endpoint
        const basePath = `${API_BASE_URL}/api/channel_pairs`; 
        const url = editingRuleId.value
          ? `${basePath}/${editingRuleId.value}` // URL for PUT
          : basePath; // URL for POST
        const method = editingRuleId.value ? 'put' : 'post';

        const payload: Omit<ChannelPairRule, 'id' | 'model_name'> = {
            source_channel: sourceChannelValue,
            target_channel: targetChannelValue,
            text_to_delete: newRule.value.text_to_delete,
            model_id: newRule.value.model_id,
            system_content: newRule.value.system_content,
            max_tokens: newRule.value.model_id ? newRule.value.max_tokens : null,
            temperature: newRule.value.model_id ? newRule.value.temperature : null,
            top_p: newRule.value.model_id ? newRule.value.top_p : null,
            hour_min: newRule.value.hour_min,
            hour_max: newRule.value.hour_max,
        };

        console.log('Saving rule with payload:', payload);

        // MODIFIED: Use the defined url and method variables
        let response;
        if (method === 'put') {
          response = await axios.put(url, payload, {
            withCredentials: true,
            headers
          });
        } else {
          response = await axios.post(url, payload, {
            withCredentials: true,
            headers
          });
        }

        console.log('Rule saved successfully:', response.data);

        // Update the rules list immediately with the new/updated rule
        if (method === 'post') {
          // For new rules, add to the list
          rules.value.push(response.data);
        } else {
          // For updated rules, replace in the list
          const index = rules.value.findIndex(r => r.id === editingRuleId.value);
          if (index !== -1) {
            rules.value[index] = response.data;
          }
        }

        showAddRuleForm.value = false;
        editingRuleId.value = null;
        newRule.value = defaultNewRule();

        console.log('Rule saved, managing worker...');

        // 1. Остановим воркер, если он запущен
        try {
          console.log('Stopping worker after rule save...');
          await stopWorker();
          console.log('Worker stopped successfully');
        } catch (error: unknown) {
          console.warn('Worker stop failed after rule save:', error instanceof Error ? error.message : String(error));
        }

        // 2. Запускаем воркер после сохранения правила
        try {
          console.log('Starting worker after rule save...');
          await startWorker();
          console.log('Worker started successfully');
        } catch (error: unknown) {
          console.warn('Worker start failed after rule save:', error instanceof Error ? error.message : String(error));
        }

        // 3. Обновляем состояние без перезагрузки страницы
        setTimeout(async () => {
          // Обновляем статус воркера
          // Показываем уведомление об успехе
          showSuccess($t('rule_created_and_worker_started'));
        }, 1000);
      } catch (error: unknown) {
        console.error('Error saving rule:', error instanceof Error ? error.message : String(error));
        // Handle error (e.g., show validation errors to the user)
        alert('Error saving rule. Please try again.');
      } finally {
        savingRule.value = false;
      }
    };

    // Helper function to get channel value for select options
    const getChannelValue = (channel: ChannelInfo): string => {
      if (channel.username) {
        return channel.username.startsWith('@') ? channel.username : `@${channel.username}`;
      }
      return channel.id.toString();
    };

    // Helper function to get display name for channel (title if available, otherwise ID/username)
    // Removed local definition since we're now injecting the function from RedesignedApp.vue
    // const getChannelDisplayName = (channelValue: string | null, channels: ChannelInfo[]): string => {
    //   if (!channelValue) return 'Не выбран';
    //   
    //   // Try to find channel by exact match (username with @)
    //   let channel = channels.find(c => getChannelValue(c) === channelValue);
    //   
    //   // If not found by username, try to find by ID
    //   if (!channel) {
    //     const channelId = channelValue.startsWith('@') ? null : parseInt(channelValue);
    //     if (channelId) {
    //       channel = channels.find(c => c.id === channelId);
    //     }
    //   }
    //   
    //   // Return title if found, otherwise return the original value
    //   if (channel && channel.title) {
    //     return channel.title;
    //   }
    //   
    //   return channelValue;
    // };

    // Helper function to normalize channel value from DB to match select options
    const normalizeChannelValue = (dbValue: string | null, channels: ChannelInfo[]): string | null => {
      if (!dbValue) return null;
      
      console.log('Normalizing channel value:', dbValue, 'against channels:', channels.map(c => ({ 
        id: c.id, 
        title: c.title, 
        username: c.username, 
        value: getChannelValue(c) 
      })));
      
      // Try to find channel by exact match first (with @)
      const exactMatch = channels.find(c => getChannelValue(c) === dbValue);
      if (exactMatch) {
        console.log('Found exact match:', exactMatch);
        return dbValue;
      }
      
      // If no exact match, try to find by username (with or without @)
      const usernameMatch = channels.find(c => {
        if (!c.username) return false;
        
        // Check various combinations
        const cleanUsername = c.username.replace('@', '');
        const cleanDbValue = dbValue.replace('@', '');
        
        return c.username === dbValue || 
               `@${c.username}` === dbValue || 
               c.username === cleanDbValue ||
               cleanUsername === cleanDbValue;
      });
      if (usernameMatch) {
        const result = getChannelValue(usernameMatch);
        console.log('Found username match:', usernameMatch, 'returning:', result);
        return result;
      }
      
      // Try to find by ID
      const idMatch = channels.find(c => c.id.toString() === dbValue);
      if (idMatch) {
        const result = getChannelValue(idMatch);
        console.log('Found ID match:', idMatch, 'returning:', result);
        return result;
      }
      
      // Try to find by ID without exact string match (handle type differences)
      if (dbValue && !isNaN(Number(dbValue))) {
        const dbId = parseInt(dbValue);
        const idMatch2 = channels.find(c => c.id === dbId);
        if (idMatch2) {
          const result = getChannelValue(idMatch2);
          console.log('Found ID match (numeric):', idMatch2, 'returning:', result);
          return result;
        }
      }
      
      // If no match found but dbValue looks like username without @, add @
      if (dbValue && !dbValue.startsWith('@') && isNaN(Number(dbValue))) {
        const result = `@${dbValue}`;
        console.log('No match found, adding @ prefix:', result);
        return result;
      }
      
      // If no match found, return original value (don't set to null which causes dropdowns to appear empty)
      console.log('No match found, returning original value:', dbValue);
      return dbValue;
    };

    const editRule = async (ruleToEdit: ChannelPairRule) => {
        editingRuleId.value = ruleToEdit.id!;
        
        console.log('Starting edit rule for:', ruleToEdit);
        
        // Show form first to make the loading indicator visible
        showAddRuleForm.value = true;
        
        // Wait for DOM to update so we can scroll to the loading indicator
        await nextTick();
        
        // Scroll to the form first to make it visible
        setTimeout(() => {
          const formElement = document.querySelector('.add-rule-form');
          if (formElement) {
            formElement.scrollIntoView({ 
              behavior: 'smooth', 
              block: 'start',
              inline: 'nearest'
            });
          }
        }, 50);
        
        // Set a small delay to ensure the form is visible before showing loading
        await new Promise(resolve => setTimeout(resolve, 100));
        
        // Always load fresh channels when editing (in case new channels were created)
        console.log('Loading fresh channels for editing...');
        await fetchChannels(true); // Force refresh
        
        // Store a copy of the channels to prevent reactivity issues
        const subscribedChannelsCopy = [...subscribedChannels.value];
        const adminChannelsCopy = [...adminChannels.value];
        
        console.log('Available channels after fetch:', {
          subscribed: subscribedChannelsCopy.map(c => ({ id: c.id, title: c.title, username: c.username, value: getChannelValue(c) })),
          admin: adminChannelsCopy.map(c => ({ id: c.id, title: c.title, username: c.username, value: getChannelValue(c) }))
        });
        
        // Set rule values with normalized channel values using the copies
        newRule.value = { 
          ...ruleToEdit,
          source_channel: normalizeChannelValue(ruleToEdit.source_channel, subscribedChannelsCopy),
          target_channel: normalizeChannelValue(ruleToEdit.target_channel, adminChannelsCopy)
        };
        
        console.log('Rule values set to:', {
          original_source: ruleToEdit.source_channel,
          normalized_source: newRule.value.source_channel,
          original_target: ruleToEdit.target_channel,
          normalized_target: newRule.value.target_channel,
          model_id: newRule.value.model_id
        });
        
        // Wait for DOM to update after setting the values
        await nextTick();
        
        // Force another DOM update to ensure select elements are properly updated
        await nextTick();
        
        // Add a small delay to ensure dropdowns are populated
        await new Promise(resolve => setTimeout(resolve, 50));
        
        // Add additional check to ensure channels are still populated
        setTimeout(() => {
          if (subscribedChannels.value.length === 0 && subscribedChannelsCopy.length > 0) {
            console.log('Restoring subscribed channels from copy');
            subscribedChannels.value = subscribedChannelsCopy;
          }
          if (adminChannels.value.length === 0 && adminChannelsCopy.length > 0) {
            console.log('Restoring admin channels from copy');
            adminChannels.value = adminChannelsCopy;
          }
        }, 200);
    };

    const deleteRule = async (id: number) => {
      if (confirm('Are you sure you want to delete this rule?')) {
        try {
          // Support both cookie-based auth and token-based auth (for TMA)
          const token = localStorage.getItem('auth_token');
          const headers: any = {};
          
          if (token) {
            headers['Authorization'] = 'Bearer ' + token;
          }
          
          await axios.delete(`${API_BASE_URL}/channel_pairs/${id}`, {
            withCredentials: true,
            headers
          });
          
          // Remove rule from local list immediately
          rules.value = rules.value.filter(rule => rule.id !== id);
          
          // Stop worker asynchronously after successful rule deletion
          stopWorker().catch(error => {
            console.warn('Worker stop failed after rule deletion:', error);
          });
          
        } catch (error: any) {
          console.error('Error deleting rule:', error);
          // If deletion failed, refresh the list to restore correct state
          await fetchRules();
        }
      }
    };

    onMounted(async () => {
      console.log('ChannelPairs: Component mounted');
      // Small delay to ensure authentication tokens are properly set
      await new Promise(resolve => setTimeout(resolve, 150));
      
      // ChannelPairs onMounted: Starting data fetch...
      console.log('ChannelPairs: Starting data fetch...');
      fetchRules();
      fetchModels();
    });

    // Add a watcher to refetch rules when the component becomes visible
    watch(() => props.hideMainUI, (newVal, oldVal) => {
      console.log('ChannelPairs: hideMainUI changed from', oldVal, 'to', newVal);
      if (!newVal) {
        // Component is now visible, refetch rules to ensure data is up to date
        console.log('ChannelPairs: Component now visible, refreshing data');
        fetchRules();
        fetchModels();
      }
    });

    // Add a watcher for when the component is shown/hidden to ensure proper data handling
    watch(() => props.hideMainUI, (newVal, oldVal) => {
      console.log('ChannelPairs: hideMainUI watcher triggered', { oldVal, newVal });
      if (oldVal === true && newVal === false) {
        // Component is being shown, ensure data is fresh
        console.log('ChannelPairs: Component being shown, refreshing data');
        fetchRules();
        fetchModels();
      }
    }, { immediate: true });

    // Watch rules changes to debug rendering issues
    watch(() => rules.value, (newRules) => {
      console.log('ChannelPairs: Rules updated', newRules);
      console.log('ChannelPairs: Rules length', newRules.length);
      if (newRules.length > 0) {
        console.log('ChannelPairs: First rule details', newRules[0]);
      }
    }, { deep: true });

    const toggleAddRuleForm = async () => {
      if (!showAddRuleForm.value) {
        // Opening the form - load fresh channels
        await fetchChannels(true); // Force refresh
        showAddRuleForm.value = true;
        
        // Wait for DOM to update and then scroll to form
        await nextTick();
        setTimeout(() => {
          const formElement = document.querySelector('.add-rule-form');
          if (formElement) {
            formElement.scrollIntoView({ 
              behavior: 'smooth', 
              block: 'start',
              inline: 'nearest'
            });
          }
        }, 100);
      } else {
        // Closing the form
        showAddRuleForm.value = false;
        editingRuleId.value = null;
        newRule.value = defaultNewRule();
      }
    };

    const openRuleWizard = () => {
      editingRuleForWizard.value = null;
      showRuleWizard.value = true;
    };

    // Provide the openRuleWizard method so it can be accessed by child components
    provide('openRuleWizard', openRuleWizard);

    const closeRuleWizard = () => {
      showRuleWizard.value = false;
      editingRuleForWizard.value = null;
    };

    const saveRuleFromWizard = async (ruleData: ChannelPairRule) => {
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        const method = ruleData.id ? 'put' : 'post';
        const url = ruleData.id 
          ? `${API_BASE_URL}/api/channel_pairs/${ruleData.id}`
          : `${API_BASE_URL}/api/channel_pairs`;
        
        const payload = {
          ...ruleData,
          source_channel: normalizeChannelForDB(ruleData.source_channel, subscribedChannels.value),
          target_channel: normalizeChannelForDB(ruleData.target_channel, adminChannels.value)
        };
        
        const response = await axios[method](url, payload, {
          withCredentials: true,
          headers
        });
        
        // Update local rules list
        if (method === 'post') {
          rules.value.push(response.data);
        } else {
          const index = rules.value.findIndex(r => r.id === ruleData.id);
          if (index !== -1) {
            rules.value[index] = response.data;
          }
        }
        
        closeRuleWizard();
        showSuccess($t('rule_saved_successfully'));
        
        // Manage worker after rule save
        try {
          await stopWorker();
          await startWorker();
        } catch (workerError) {
          console.warn('Worker management failed after rule save:', workerError);
        }
      } catch (error: any) {
        console.error('Error saving rule from wizard:', error);
        showError($t('error_saving_rule') + ': ' + (error.response?.data?.detail || error.message));
      }
    };

    const handleRuleCreatedSuccessfully = () => {
      // Emit event to parent component
      emit('rule-created-successfully');
      
      // Refresh rules list
      fetchRules();
      
      // Close wizard
      closeRuleWizard();
    };

    const refreshChannels = async () => {
      await fetchChannels(true); // Force refresh
      showSuccess($t('channels_refreshed'));
    };

    const toggleCreateChannelForm = () => {
      showCreateChannelForm.value = !showCreateChannelForm.value;
      if (!showCreateChannelForm.value) {
        // Reset form when closing
        newChannel.value = {
          title: '',
          description: '',
          is_megagroup: false
        };
      }
    };

    const createChannel = async () => {
      if (creatingChannel.value) return;
      
      creatingChannel.value = true;
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        const response = await axios.post(`${API_BASE_URL}/channels/create`, newChannel.value, {
          withCredentials: true,
          headers
        });
        
        showSuccess($t('channel_created_successfully'));
        
        // Reset form
        newChannel.value = {
          title: '',
          description: '',
          is_megagroup: false
        };
        
        // Hide form
        showCreateChannelForm.value = false;
        
        // Refresh channels
        await fetchChannels(true);
      } catch (error: any) {
        console.error('Error creating channel:', error);
        showError($t('error_creating_channel') + ': ' + (error.response?.data?.detail || error.message));
      } finally {
        creatingChannel.value = false;
      }
    };

    const toggleAdvancedSettings = (ruleId: number) => {
      showAdvanced.value = {
        ...showAdvanced.value,
        [ruleId]: !showAdvanced.value[ruleId]
      };
    };

    // Watch for preloaded channels changes
    watch(() => props.preloadedChannels, (newChannels) => {
      // Only update channels if the form is not currently being used for editing
      if (props.channelsLoaded && newChannels && !showAddRuleForm.value) {
        subscribedChannels.value = newChannels.subscribed;
        adminChannels.value = newChannels.admin;
        channelsLoaded.value = true;
      }
    }, { deep: true });

    // Expose methods for parent components
    defineExpose({
      fetchRules,
      fetchChannels,
      refreshChannels,
      openRuleWizard
    });

    return {
      rules,
      models,
      showAddRuleForm,
      editingRuleId,
      subscribedChannels,
      adminChannels,
      loadingChannels,
      channelsLoaded,
      savingRule,
      expandedRules,
      showAdvanced,
      newRule,
      showCreateChannelForm,
      creatingChannel,
      newChannel,
      showRuleWizard,
      editingRuleForWizard,
      showProgress,
      progressSteps,
      getRowClass,
      getChannelValue,
      getChannelDisplayName,
      fetchRules,
      fetchModels,
      fetchChannels,
      onModelChange,
      saveRule,
      editRule,
      deleteRule,
      toggleAddRuleForm,
      openRuleWizard,
      closeRuleWizard,
      saveRuleFromWizard,
      handleRuleCreatedSuccessfully,
      refreshChannels,
      toggleCreateChannelForm,
      createChannel,
      toggleAdvancedSettings
    };
  }
});
</script>

