<template>
  <div class="channel-pairs-container" :class="{ 'hidden-ui': hideMainUI }">
    <h2 v-if="!hideMainUI" class="channel-pairs-title">
      {{ $t('channel_pair_rules') }}
      <span class="debug-tag">fix-20241014-chan</span>
    </h2>

    <!-- Display existing rules -->
    <div v-if="rules.length > 0 && !hideMainUI" class="rules-list">
      <div class="rules-cards">
        <div v-for="(rule, index) in rules" :key="rule.id" class="rule-card">
          <div v-if="index < 5">
            <!-- Only log first 5 rules to avoid console spam -->
            {{ console.log('ChannelPairs: Rendering rule', index, rule) }}
          </div>
          <!-- Card Header -->
          <div class="rule-card-header">
            <div class="rule-info-left">
              <div class="rule-number">{{ $t('rule') }} {{ index + 1 }}</div>
              <div class="rule-actions">
                <button @click="editRule(rule)" class="action-btn edit-btn" :title="$t('edit_rule')">
                  <svg class="icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                </button>
                <button v-if="rule.id" @click="deleteRule(rule.id)" class="action-btn delete-btn" :title="$t('delete_rule')">
                  <svg class="icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <polyline points="3,6 5,6 21,6"/>
                    <path d="M19,6v14a2,2,0 0,1-2,2H7a2,2,0 0,1-2-2V6m3,0V4a2,2,0 0,1,2-2h4a2,2,0 0,1,2,2V6"/>
                    <line x1="10" y1="11" x2="10" y2="17"/>
                    <line x1="14" y1="11" x2="14" y2="17"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="channel-flow">
              <div class="channel-info source">
                <div class="channel-label">{{ $t('source_channel') }}</div>
                <div class="channel-name">{{ getChannelDisplayName(rule.source_channel, subscribedChannels) }}</div>
              </div>
              <div class="flow-arrow">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M5 12h14m-7-7 7 7-7 7"/>
                </svg>
              </div>
              <div class="channel-info target">
                <div class="channel-label">{{ $t('target_channel') }}</div>
                <div class="channel-name">{{ getChannelDisplayName(rule.target_channel, adminChannels) }}</div>
              </div>
            </div>
          </div>

          <!-- Main Rule Content -->
          <div class="rule-content">
            <div v-if="rule.system_content" class="processing-rule">
              <div class="rule-label">{{ $t('ai_instruction') }}:</div>
              <div class="rule-text">
                {{ rule.system_content }}
              </div>
            </div>
            
            <!-- Quick Info Tags -->
            <div class="rule-tags">
              <span v-if="rule.model_name" class="tag model-tag">
                <svg class="tag-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M9.663 17h4.673M12 3v1m6.364 1.636-.707.707M21 12h-1M4 12H3m3.343-5.657-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
                {{ rule.model_name }}
              </span>
              <span v-if="rule.text_to_delete" class="tag delete-tag">
                <svg class="tag-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M3 6h18m-2 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
                </svg>
                {{ $t('delete_text_before_processing') }}: "{{ rule.text_to_delete }}"
              </span>
              <span class="tag time-tag">
                <svg class="tag-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12,6 12,12 16,14"/>
                </svg>
                {{ $t('delay_post_after_previous') }}: {{ rule.hour_min }}h - {{ rule.hour_max }}h
              </span>
            </div>

            <!-- Advanced Settings (Collapsible) -->
            <div class="advanced-settings" v-if="rule.model_name && rule.id">
              <button 
                @click="toggleAdvancedSettings(rule.id)"
                class="advanced-toggle">
                <svg class="toggle-icon" width="28" height="28" :class="{ 'rotated': rule.id && showAdvanced[rule.id] }" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <polyline points="6,9 12,15 18,9"/>
                </svg>
                {{ $t('advanced_settings') }}
              </button>
              <div v-if="rule.id && showAdvanced[rule.id]" class="advanced-content">
                <div class="param-grid">
                  <div class="param-item">
                    <span class="param-label">{{ $t('max_tokens') }}:</span>
                    <span class="param-value">{{ rule.max_tokens || 'Auto' }}</span>
                  </div>
                  <div class="param-item">
                    <span class="param-label">{{ $t('temperature') }}:</span>
                    <span class="param-value">{{ rule.temperature || 'Auto' }}</span>
                  </div>
                  <div class="param-item">
                    <span class="param-label">{{ $t('top_p') }}:</span>
                    <span class="param-value">{{ rule.top_p || 'Auto' }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div v-else-if="!hideMainUI">
      <p>{{ $t('no_channel_rules') }}</p>
    </div>

    <!-- Add new rule form -->
    <div v-if="!hideMainUI" class="add-rule-section">
      <div class="action-buttons">
        <button @click="openRuleWizard" class="wizard-btn">
          {{ $t('add_new_rule') }}
        </button>
        <button @click="toggleAddRuleForm" class="classic-form-btn">
          {{ showAddRuleForm ? $t('cancel') : $t('classic_form') }}
        </button>
        <button @click="toggleCreateChannelForm" class="create-channel-btn">
          {{ showCreateChannelForm ? $t('cancel') : $t('create_channel') }}
        </button>
      </div>
      
      <!-- Loading indicator -->
      <div v-if="loadingChannels" class="loading-indicator">
        <div class="spinner"></div>
        <span>{{ $t('loading_available_channels') }}</span>
      </div>

      <form v-if="showAddRuleForm" @submit.prevent="saveRule" class="add-rule-form">
        <div class="form-header">
          <h3>{{ editingRuleId ? $t('edit_rule_title') : $t('add_new_rule') }}</h3>
          <button type="button" @click="refreshChannels" class="refresh-channels-btn" :disabled="loadingChannels" :title="$t('refresh_channels')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" :class="{ 'spinning': loadingChannels }">
              <polyline points="23 4 23 10 17 10"/>
              <polyline points="1 20 1 14 7 14"/>
              <path d="m3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
            </svg>
            {{ $t('refresh_channels') }}
          </button>
        </div>
        <div class="channel-fields">
          <div class="channel-field">
            <label for="source_channel">{{ $t('source_channel_label') }}</label>
            <select id="source_channel" v-model="newRule.source_channel" required>
              <option value="">{{ $t('select_draft_channel') }}</option>
              <option v-for="channel in subscribedChannels" :key="channel.id" :value="getChannelValue(channel)">
                {{ channel.title }} {{ channel.username ? `(@${channel.username})` : `(ID: ${channel.id})` }}
              </option>
            </select>
          </div>
          
          <div class="channel-field">
            <label for="target_channel">{{ $t('target_channel_label') }}</label>
            <select id="target_channel" v-model="newRule.target_channel" required>
              <option value="">{{ $t('select_clean_channel') }}</option>
              <option v-for="channel in adminChannels" :key="channel.id" :value="getChannelValue(channel)">
                {{ channel.title }} {{ channel.username ? `(@${channel.username})` : `(ID: ${channel.id})` }}
              </option>
            </select>
          </div>
        </div>
        <div>
          <label for="text_to_delete">{{ $t('text_to_delete_label') }}</label>
          <input type="text" id="text_to_delete" v-model="newRule.text_to_delete">
        </div>
        <div>
          <label for="model_id">{{ $t('ai_model_label').replace(' (необязательно)', '').replace(' (optional)', '') }} {{ $t('price_per_post_label') }}</label>
          <select id="model_id" v-model="newRule.model_id" @change="onModelChange">
            <option :value="null">{{ $t('none') }}</option>
            <option v-for="model in models" :key="model.id" :value="model.id">
              {{ model.model }} (<PriceDisplay :price="model.price_per_post || 0" :decimals="3" />)
            </option>
          </select>
        </div>
        <div v-if="newRule.model_id" class="model-settings">
          <div class="system-content">
            <label for="system_content">{{ $t('system_content') }}</label>
            <textarea id="system_content" v-model="newRule.system_content"></textarea>
          </div>
          <div class="model-params">
            <div>
              <label for="max_tokens">{{ $t('max_tokens_label') }}</label>
              <input type="number" id="max_tokens" v-model.number="newRule.max_tokens" min="50" max="5000">
            </div>
            <div>
              <label for="temperature">{{ $t('temperature_label') }}</label>
              <input type="number" step="0.1" id="temperature" v-model.number="newRule.temperature">
            </div>
            <div>
              <label for="top_p">{{ $t('top_p_label') }}</label>
              <input type="number" step="0.1" id="top_p" v-model.number="newRule.top_p">
            </div>
          </div>
        </div>
        <div class="hour-range-field">
          <div class="hour-range-single-line">
            <span>{{ $t('postpone_post_text') }}</span>
            <input type="number" id="hour_min" v-model.number="newRule.hour_min" min="0" max="23" style="width: 60px; margin: 0 5px;">
            <span>{{ $t('to') }}</span>
            <input type="number" id="hour_max" v-model.number="newRule.hour_max" min="0" max="23" style="width: 60px; margin: 0 5px;">
            <span>{{ $t('hours') }}</span>
          </div>
        </div>
        <button type="submit" :disabled="savingRule" class="save-button">
          <div v-if="savingRule" class="button-spinner"></div>
          <span v-if="!savingRule">{{ editingRuleId ? $t('update_rule') : $t('save_rule') }}</span>
          <span v-else>{{ $t('saving') }}</span>
        </button>
      </form>
    </div>

    <!-- Create channel form -->
    <form v-if="showCreateChannelForm" @submit.prevent="createChannel" class="create-channel-form">
        <div>
          <label for="channel_title">{{ $t('channel_title') }}</label>
          <input 
            type="text" 
            id="channel_title" 
            v-model="newChannel.title" 
            :placeholder="$t('channel_title')"
            required
          >
        </div>
        
        <div>
          <label for="channel_description">{{ $t('channel_description') }}</label>
          <textarea 
            id="channel_description" 
            v-model="newChannel.description"
            :placeholder="$t('channel_description')"
            rows="3"
          ></textarea>
        </div>
        
        <div class="checkbox-field">
          <label>
            <input 
              type="checkbox" 
              v-model="newChannel.is_megagroup"
            >
            {{ $t('create_as_supergroup') }}
          </label>
        </div>
        
        <button type="submit" :disabled="creatingChannel || !newChannel.title.trim()" class="create-button">
          <div v-if="creatingChannel" class="button-spinner"></div>
          <span v-if="!creatingChannel">{{ $t('create_channel') }}</span>
          <span v-else>{{ $t('creating') }}...</span>
        </button>
        
        <!-- Show validation hints -->
        <div v-if="newChannel.title && newChannel.title.length > 200" class="validation-hint warning">
          ⚠️ {{ $t('channel_title_too_long') }}
        </div>
        <div v-if="newChannel.description && newChannel.description.length > 200" class="validation-hint warning">
          ⚠️ {{ $t('channel_description_too_long') }}
        </div>
      </form>

    <!-- Rule Wizard -->
    <RuleWizard
      v-if="showRuleWizard"
      :channels="{ subscribed: subscribedChannels, admin: adminChannels }"
      :models="models"
      :editing-rule="editingRuleForWizard as Record<string, any> | undefined"
      :loading-channels="loadingChannels"
      @close="closeRuleWizard"
      @save="saveRuleFromWizard"
      @refresh-channels="refreshChannels"
      @rule-created-successfully="handleRuleCreatedSuccessfully"
    />
    
    <!-- Progress Indicator -->
    <ProgressIndicator
      :show="showProgress"
      :title="$t('creating_rule_and_starting_worker')"
      :steps="progressSteps"
    </ProgressIndicator>
  </div>
</template>

<script lang="ts">
import { defineComponent, ref, onMounted, nextTick, watch, type PropType, provide, defineExpose, inject } from 'vue';
import axios from 'axios';
import { API_BASE_URL } from '@/config';
import { getDefaultSystemPrompt } from '@/utils/systemPrompt';
import { useI18n } from 'vue-i18n';
import RuleWizard from './RuleWizard/RuleWizard.vue';
import PriceDisplay from './PriceDisplay.vue';
import ProgressIndicator from './ProgressIndicator.vue';
import { useNotifications } from '../composables/useNotifications.ts';

type ProgressStatus = 'pending' | 'loading' | 'completed' | 'error';

interface ProgressStep {
  title: string;
  description: string;
  status: ProgressStatus;
}

interface Model {
  id: number;
  model: string;
  system_content: string | null;
  user_content: string | null;
  max_tokens: number | null;
  temperature: number | null;
  top_p: number | null;
  price_per_post: number | null;
}

interface ChannelInfo {
  id: number;
  title: string;
  username?: string;
  photo_url?: string;
  type: string;
  is_admin: boolean;
}

interface ChannelPairRule {
  id?: number;
  source_channel: string | null; // Changed from number to string
  target_channel: string | null; // Changed from number to string
  text_to_delete: string | null;
  model_id: number | null;
  model_name?: string; // For display
  system_content: string | null;
  max_tokens: number | null;
  temperature: number | null;
  top_p: number | null;
  hour_min: number | null;
  hour_max: number | null;
}

export default defineComponent({
  name: 'ChannelPairs',
  components: {
    RuleWizard,
    PriceDisplay,
    ProgressIndicator
  },
  props: {
    preloadedChannels: {
      type: Object as PropType<{ subscribed: ChannelInfo[], admin: ChannelInfo[] }>,
      default: () => ({ subscribed: [], admin: [] })
    },
    channelsLoaded: {
      type: Boolean,
      default: false
    },
    hideMainUI: {
      type: Boolean,
      default: false
    }
  },
  emits: ['rule-created-successfully'],
  setup(props, { emit }) {
    // Initialize i18n
    const { t: $t, locale } = useI18n();
    
    // Create a robust getChannelDisplayName function with proper local implementation
    // Always use the local implementation to avoid injection issues
    // Handle gracefully when channels have been deleted from Telegram
    const getChannelDisplayName = (channelValue: string | null, channels: ChannelInfo[] | { value: ChannelInfo[] }) => {
      try {
        // Handle both direct arrays and refs to arrays
        const channelsArray = Array.isArray(channels) ? channels : (channels && 'value' in channels && Array.isArray(channels.value) ? channels.value : []);
        if (!channelValue || !Array.isArray(channelsArray)) return channelValue || 'Unknown Channel';
        
        // Try to find channel by exact match (username with @)
        let channel = channelsArray.find(c => getChannelValue(c) === channelValue);
        
        // If not found by username, try to find by ID
        if (!channel && channelValue && !channelValue.startsWith('@')) {
          const channelId = parseInt(channelValue);
          if (!isNaN(channelId)) {
            channel = channelsArray.find(c => c.id === channelId);
          }
        }
        
        // Also try to match by username without @ prefix
        if (!channel && channelValue && channelValue.startsWith('@')) {
          const cleanUsername = channelValue.replace('@', '');
          channel = channelsArray.find(c => 
            (c.username && (c.username === channelValue || c.username === cleanUsername)) ||
            (c.username && c.username.startsWith('@') && c.username === channelValue)
          );
        }
        
        // Return title if found, otherwise return the original value (don't mark as deleted unless confirmed)
        if (channel && channel.title) {
          return channel.title;
        }
        
        // Only mark as deleted if we can confirm it's actually missing
        // For now, just return a clean display name
        if (channelValue) {
          // If it looks like a username
          if (channelValue.startsWith('@')) {
            return channelValue;
          }
          // If it looks like an ID
          else if (!isNaN(parseInt(channelValue))) {
            return `Channel ID: ${channelValue}`;
          }
          // Otherwise show the original value
          else {
            return channelValue;
          }
        }
        
        return 'Unknown Channel';
      } catch (error) {
        console.error('Error in getChannelDisplayName:', error);
        return '[Error Loading Channel]';
      }
    };
    
    // Debugging: Log that we're using the local implementation
    console.log('ChannelPairs: Using local getChannelDisplayName implementation');
    
    // Initialize notifications
    const { showSuccess, showError, showWarning } = useNotifications();
    
    // Add showSuccessNotification alias for compatibility
    const showSuccessNotification = showSuccess;
    const rules = ref<ChannelPairRule[]>([]);
    const models = ref<Model[]>([]);
    const showAddRuleForm = ref(false);
    const editingRuleId = ref<number | null>(null);
    const subscribedChannels = ref<ChannelInfo[]>([]);
    const adminChannels = ref<ChannelInfo[]>([]);
    const loadingChannels = ref(false);
    const channelsLoaded = ref(false);
    const savingRule = ref(false);
    
    // Card state management
    const expandedRules = ref<{ [key: number]: boolean }>({});
    const showAdvanced = ref<{ [key: number]: boolean }>({});
    
    const defaultNewRule: () => ChannelPairRule = () => ({
      id: undefined, // Ensure id is reset for new rules
      source_channel: null,
      target_channel: null,
      text_to_delete: '', // Or null, depending on preference
      model_id: null,
      system_content: null,
      max_tokens: null,
      temperature: null,
      top_p: null,
      hour_min: 7,
      hour_max: 9,
    });

    const newRule = ref<ChannelPairRule>(defaultNewRule());

    // Create channel form variables
    const showCreateChannelForm = ref(false);
    const creatingChannel = ref(false);
    const newChannel = ref({
      title: '',
      description: '',
      is_megagroup: false
    });

    // Wizard state
    const showRuleWizard = ref(false);
    const editingRuleForWizard = ref<ChannelPairRule | null>(null);
    
    // Progress indicator state
    const showProgress = ref(false);
    const progressSteps = ref<ProgressStep[]>([
      { title: 'Остановка воркера', description: 'Подготовка к обновлению', status: 'pending' },
      { title: 'Сохранение правила', description: 'Создание нового правила', status: 'pending' },
      { title: 'Запуск воркера', description: 'Применение изменений', status: 'pending' },
      { title: 'Обновление статуса', description: 'Финализация', status: 'pending' }
    ]);

    // Function to get row class for alternating colors
    const getRowClass = (index: number): string => {
      return index % 2 === 0 ? 'row-even' : 'row-odd';
    };

    const fetchRules = async () => {
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        const response = await axios.get(`${API_BASE_URL}/api/channel_pairs`, {
          withCredentials: true,
          headers
        });
        rules.value = response.data;
      } catch (error: unknown) {
        console.error('Error fetching rules:', error instanceof Error ? error.message : String(error));
        // Handle error (e.g., show a notification to the user)
      }
    };

    const fetchModels = async () => {
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        const response = await axios.get(`${API_BASE_URL}/api/channel_pairs/models`, {
          withCredentials: true,
          headers
        });
        models.value = response.data;
      } catch (error: unknown) {
        console.error('Error fetching models:', error instanceof Error ? error.message : String(error));
      }
    };

    const fetchChannels = async (forceRefresh = false) => {
      // Use preloaded channels if available and not forcing refresh
      if (props.channelsLoaded && !forceRefresh && props.preloadedChannels) {
        subscribedChannels.value = props.preloadedChannels.subscribed;
        adminChannels.value = props.preloadedChannels.admin;
        channelsLoaded.value = true;
        console.log(`Using preloaded channels: ${subscribedChannels.value.length} subscribed, ${adminChannels.value.length} admin`);
        return;
      }
      
      if (channelsLoaded.value && !forceRefresh) return;
      
      loadingChannels.value = true;
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        const response = await axios.get(`${API_BASE_URL}/api/channel_pairs/channels`, {
          withCredentials: true,
          headers
        });
        subscribedChannels.value = response.data.subscribed_channels;
        adminChannels.value = response.data.admin_channels;
        channelsLoaded.value = true;
        
        console.log(`Channels loaded: ${subscribedChannels.value.length} subscribed, ${adminChannels.value.length} admin`);
      } catch (error: unknown) {
        console.error('Error fetching channels:', error instanceof Error ? error.message : String(error));
        // Handle error (e.g., show notification to user)
      } finally {
        loadingChannels.value = false;
      }
    };

    const onModelChange = async () => {
      if (newRule.value.model_id) {
        const selectedModel = models.value.find(m => m.id === newRule.value.model_id);
        console.log('Selected Model for param population:', selectedModel); // For debugging
        
        const defaultSystemPrompt = await getDefaultSystemPrompt(locale.value);
        
        if (selectedModel) {
          newRule.value.system_content = defaultSystemPrompt; // Use project settings instead of selectedModel.system_content
          newRule.value.max_tokens = selectedModel.max_tokens;
          newRule.value.temperature = selectedModel.temperature;
          newRule.value.top_p = selectedModel.top_p;
        }
      } else {
        // Reset AI params if no model is selected
        newRule.value.system_content = null;
        newRule.value.max_tokens = null;
        newRule.value.temperature = null;
        newRule.value.top_p = null;
      }
    };

    watch(() => newRule.value.model_id, async (val) => {
      if (val) {
        const selectedModel = models.value.find(m => m.id === val);
        const defaultSystemPrompt = await getDefaultSystemPrompt(locale.value);
        newRule.value.system_content = defaultSystemPrompt;
        if (selectedModel) {
          newRule.value.max_tokens = selectedModel.max_tokens;
          newRule.value.temperature = selectedModel.temperature;
          newRule.value.top_p = selectedModel.top_p;
        }
      } else {
        newRule.value.system_content = null;
        newRule.value.max_tokens = null;
        newRule.value.temperature = null;
        newRule.value.top_p = null;
      }
    });

    // Helper function to ensure channel value has @ prefix for usernames
    const normalizeChannelForDB = (channelValue: string | null, channels: ChannelInfo[]): string | null => {
      if (!channelValue) return null;
      
      // Find the channel info to determine if we should save username or ID
      const channel = channels.find(c => getChannelValue(c) === channelValue);
      
      if (channel) {
        // If channel has username, save username with @
        if (channel.username) {
          return channel.username.startsWith('@') ? channel.username : `@${channel.username}`;
        }
        // If no username, save ID
        return channel.id.toString();
      }
      
      // Fallback: if it's a numeric ID, keep as is
      if (!isNaN(Number(channelValue))) {
        return channelValue;
      }
      
      // If it's a username, ensure it starts with @
      return channelValue.startsWith('@') ? channelValue : `@${channelValue}`;
    };

    // Progress management functions
    const updateProgressStep = (stepIndex: number, status: ProgressStatus) => {
      if (progressSteps.value[stepIndex]) {
        progressSteps.value[stepIndex].status = status;
      }
    };
    
    const resetProgress = () => {
      progressSteps.value.forEach(step => {
        step.status = 'pending';
      });
    };
    
    const showProgressModal = () => {
      resetProgress();
      showProgress.value = true;
    };
    
    const hideProgressModal = () => {
      showProgress.value = false;
    };
    
    // Функция для получения статуса воркера
    const fetchWorkerStatus = async () => {
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        const response = await axios.get(`${API_BASE_URL}/api/workers/status`, {
          withCredentials: true,
          headers
        });
        return response.data;
      } catch (error: any) {
        console.error('Error fetching worker status:', error);
        return { status: 'unknown' };
      }
    };
    
    // Add fetchChannelPairs alias for compatibility
    const fetchChannelPairs = fetchRules;

    // Function to play sound (improved version with async/await)
    const playSound = async (soundName: string) => {
      try {
        const audio = new Audio(`/sounds/${soundName}.mp3`);
        audio.volume = 0.5;
        
        // Preload the audio
        audio.load();
        
        // Wait for audio to be ready and play
        await new Promise((resolve, reject) => {
          audio.addEventListener('canplaythrough', resolve, { once: true });
          audio.addEventListener('error', reject, { once: true });
        });
        
        const playPromise = audio.play();
        if (playPromise !== undefined) {
          await playPromise;
          console.log(`Sound ${soundName} played successfully`);
        }
      } catch (e) {
        console.log(`Sound playback error for ${soundName}:`, e);
        // Fallback: try to play without waiting
        try {
          const fallbackAudio = new Audio(`/sounds/${soundName}.mp3`);
          fallbackAudio.volume = 0.3;
          fallbackAudio.play();
        } catch (fallbackError) {
          console.log('Fallback sound also failed:', fallbackError);
        }
      }
    };
    
    // Function to stop worker
    const stopWorker = async () => {
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        // First check if worker is actually running to avoid unnecessary API calls
        const statusResponse = await axios.get(`${API_BASE_URL}/api/workers/status`, {
          withCredentials: true,
          headers
        });
        
        if (statusResponse.data.status === 'stopped' || statusResponse.data.status === 'not_configured') {
          console.log('Worker is already stopped, skipping stop request');
          return;
        }
        
        await axios.post(`${API_BASE_URL}/api/workers/stop`, {}, {
          withCredentials: true,
          headers
        });
        console.log('Worker stopped successfully');
        // Play stop sound when worker is stopped
        await playSound('stop');
      } catch (error: unknown) {
        console.error('Error stopping worker:', error instanceof Error ? error.message : String(error));
        // Don't throw error - worker stop is not critical for rule saving
      }
    };

    // Function to start worker
    const startWorker = async () => {
      try {
        // Support both cookie-based auth and token-based auth (for TMA)
        const token = localStorage.getItem('auth_token');
        const headers: any = {};
        
        if (token) {
          headers['Authorization'] = 'Bearer ' + token;
        }
        
        // First check if worker is already running to avoid unnecessary API calls
        const statusResponse = await axios.get(`${API_BASE_URL}/api/workers/status`, {
          withCredentials: true,
          headers
        });
        
        if (statusResponse.data.status === 'running' || statusResponse.data.status === 'active') {
          console.log('Worker is already running, skipping start request');
          return;
        }
        
        await axios.post(`${API_BASE_URL}/api/workers/start`, {}, {
          withCredentials: true,
          headers
        });
        console.log('Worker started successfully');
        // Play work sound when worker is started
        await playSound('work');
      } catch (error: unknown) {
        console.error('Error starting worker:', error instanceof Error ? error.message : String(error));
        // Don't throw error - worker start failure shouldn't prevent rule creation
      }
    };

    const saveRule = async () => {
      try {
        const audio = new Audio(`/sounds/${soundName}.mp3`);
        audio.volume = 0.5;
        
        // Preload the audio
        audio.load();
        
        // Wait for audio to be ready and play
        await new Promise((resolve, reject) => {
          audio.addEventListener('canplaythrough', resolve, { once: true });
          audio.addEventListener('error', reject, { once: true });
        });
        
        const playPromise = audio.play();
        if (playPromise !== undefined) {
          await playPromise;
          console.log(`Sound ${soundName} played successfully`);
        }
      } catch (e) {
        console.log(`Sound playback error for ${soundName}:`, e);
        // Fallback: try to play without waiting
        try {
